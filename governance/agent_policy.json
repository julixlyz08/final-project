{
  "policy_name": "Nazarian Advising Consortium Analytics Agent Policy",
  "policy_version": "1.1",
  "system": "Nazarian advising consortium analytics agent team",
  "owner": "Accounting Department Advising Office (team: Nazarian Advising Consortium)",
  "approved_by": "Consortium Steering Committee (governance owner: Julie Loyez)",
  "purpose": "Answer descriptive, diagnostic, predictive and prescriptive questions about students at risk of failing a core course across the four departments, and arrange advising outreach and tutoring referrals for high-risk enrollments at the home department. Decision support only.",

  "allowed_tools": ["summarize_member", "segment_breakdown", "trend_by_month",
                    "compare_members", "rank_drivers", "compare_month_over_month", "segment_rates_all_members",
                    "segment_driver", "driver_signs_all_members", "calibration_check",
                    "model_card_facts", "predict_record", "rank_records_by_risk",
                    "recommend_action", "refer_to_tutoring", "send_advising_outreach", "notify_instructor"],
  "approval_required": ["send_advising_outreach", "notify_instructor"],
  "forbidden_for_any_agent": ["drop_student_from_course", "export_records"],

  "record_level_tools": ["predict_record", "rank_records_by_risk", "recommend_action", "refer_to_tutoring", "send_advising_outreach", "notify_instructor"],
  "max_tool_calls_per_task": 12,
  "max_records_per_task": 3,
  "data_scope": {
    "aggregate_members": ["Accounting", "Business Analytics", "Marketing", "Real Estate"],
    "record_level_members": ["Accounting"]
},

  "model": {
    "path": "models/federated_model.json",
    "min_neutral_test_accuracy": 0.66,
    "high_risk_threshold": 0.5,
    "allowed_uses": ["advising outreach prioritization", "tutoring referrals in the first month"],
    "prohibited_uses": ["admissions decisions", "financial aid decisions", "grading decisions", "sharing records across departments", "labeling students to instructors"]
  },

  "logging": { "audit_log": "artifacts/agent_audit_log.jsonl", "log_arguments": true },
  "stop_on_violation": true,
  "expose_tools_to_planner": "all"
}
